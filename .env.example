# Copie para .env.local (ignorado pelo git) e ajuste.
# Usado por `npm run device:release` e pelos build-android-release*.sh. Tudo é opcional: o que faltar é perguntado.
CB_KEYSTORE=~/keys/controlbit-upload.jks
CB_KEY_ALIAS=controlbit-upload
# CB_STORE_PASS=
# CB_KEY_PASS=
# SHA-1 da chave de upload no Google Play Console (só build-android-release*.sh)
# CB_EXPECTED_SHA1=
